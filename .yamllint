---
# yamllint settings compatible with ansible-lint's recommendations.
extends: default
ignore: |
  .venv/
  lab/.secrets/
  reports/
rules:
  line-length:
    max: 160
  document-start: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false          # GitHub Actions uses an "on:" key
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
