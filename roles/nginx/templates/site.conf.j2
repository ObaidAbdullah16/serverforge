# {{ ansible_managed }}
# HTTP: only Let's Encrypt challenges and a redirect to HTTPS.
server {
    listen 80 default_server;
{% if nginx_ipv6 %}
    listen [::]:80 default_server;
{% endif %}
    server_name {{ nginx_server_name }};

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
{% if nginx_https_ready | default(true) %}

server {
    # "listen ... http2" works on nginx 1.24 (Ubuntu 24.04). From 1.25.1 the new
    # form is a separate "http2 on;" line, which 1.24 does not understand.
    listen 443 ssl http2 default_server;
{% if nginx_ipv6 %}
    listen [::]:443 ssl http2 default_server;
{% endif %}
    server_name {{ nginx_server_name }};

    ssl_certificate     {{ nginx_ssl_certificate }};
    ssl_certificate_key {{ nginx_ssl_certificate_key }};

    # Security headers (the app's page uses only inline styles, no scripts)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'" always;
{% if nginx_tls_mode == 'letsencrypt' %}
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_read_timeout 10s;

    # Internal endpoints: only from the server itself (or Prometheus via SSH tunnel)
    location = /metrics {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://{{ nginx_upstream }};
    }

    location /api/ {
        limit_req zone=sf_api burst={{ nginx_rate_burst }} nodelay;
        proxy_pass http://{{ nginx_upstream }};
    }

    location / {
        proxy_pass http://{{ nginx_upstream }};
    }
}
{% endif %}
